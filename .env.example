# Docker Compose only: the domain Caddy serves and gets an HTTPS certificate for.
DOMAIN=

# Optional: the first-run page at /setup can collect these instead. A value set here wins, and /setup can't change it.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_SECRET=
LLM_API_KEY=
# Generated on first start when empty.
COOKIE_SECRET=
# Demo mode: test accounts instead of Discord login (anyone can log in as admin), sample data on an empty database,
# canned AI when LLM_API_KEY is empty. Local dev / demos only, never in production.
# DEV_LOGIN=1
